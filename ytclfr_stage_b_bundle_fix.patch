diff -ruN a/tests/unit/stage_b/test_stage_b_extraction.py b/tests/unit/stage_b/test_stage_b_extraction.py
--- a/tests/unit/stage_b/test_stage_b_extraction.py	1970-01-01 00:00:00.000000000 +0000
